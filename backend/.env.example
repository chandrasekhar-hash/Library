# ── Aks (अक्स) Server Environment Configuration ──────────────────────────────
# Application Port
PORT=5050

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origin for the Frontend (comma-separated for multiple origins e.g. production and preview)
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL / Neon Database Configuration ───────────────────────────────
# Pooled connection string for runtime queries (e.g. Neon connection pooler with PgBouncer)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/aks_db?sslmode=require&pgbouncer=true
# Direct connection string for Prisma migrations (bypasses PgBouncer for transactional DDL locks)
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/aks_db?sslmode=require

# ── Session & Cookie Security ───────────────────────────────────────────────
# Session Secret (cryptographically random 64+ char string for HMAC signing)
SESSION_SECRET=your_long_cryptographically_secure_session_secret_change_in_production
# Cookie SameSite policy: 'lax' (recommended for same-origin/subdomain) or 'none' (for cross-site)
COOKIE_SAME_SITE=lax
# Cookie Secure flag: 'true' (required in production HTTPS) or 'false'
COOKIE_SECURE=false
# Optional cookie domain for subdomains (e.g. .yourdomain.com)
COOKIE_DOMAIN=
# Reverse Proxy Trust Configuration (1 for Render/Vercel reverse proxies, false in local dev)
TRUST_PROXY=1

# ── File Storage Provider Configuration ────────────────────────────────────
# Storage provider: 'local' (filesystem) or 'r2' (Cloudflare R2 object storage)
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=150

# Cloudflare R2 Object Storage Credentials (required only when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aks-storage
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ── Multi-User Resource Protection: Storage Quotas ─────────────────────────
# Maximum storage quota per user account in bytes (default: 250 MB = 262,144,000 bytes)
MAX_USER_STORAGE_BYTES=262144000
# Maximum single PDF upload size in bytes (default: 150 MB = 157,286,400 bytes)
MAX_PDF_SIZE_BYTES=157286400
# Maximum cover image upload size in bytes (default: 5 MB = 5,242,880 bytes)
MAX_COVER_SIZE_BYTES=5242880
# Maximum custom media asset upload size in bytes (default: 50 MB = 52,428,800 bytes)
MAX_ASSET_SIZE_BYTES=52428800

# ── Multi-User Resource Protection: Rate Limits ────────────────────────────
# Upload rate limits (window in ms, max uploads per window per user)
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30
# Book search rate limits (window in ms, max searches per window per user)
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60
# OCR dispatch rate limits (window in ms, max dispatches per window per user)
OCR_DISPATCH_RATE_LIMIT_WINDOW_MS=900000
OCR_DISPATCH_RATE_LIMIT_MAX=20

# ── OCR Safeguards & Queue Management ──────────────────────────────────────
# Maximum page count permitted for OCR processing on a volume (default: 2000 pages)
MAX_OCR_PAGE_COUNT=2000
# Maximum queued OCR jobs per user account (default: 10 jobs)
MAX_QUEUED_OCR_JOBS_PER_USER=10
# Global concurrent OCR job limit across all users (default: 1 to protect worker RAM)
OCR_MAX_CONCURRENT_JOBS=1

# ── Internal Python OCR Engine Integration ────────────────────────────────
OCR_WORKER_URL=http://127.0.0.1:5060
OCR_WORKER_TOKEN=aks-internal-dev-token
OCR_WORKER_TIMEOUT_MS=300000

# ── Google OAuth 2.0 (Optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback
