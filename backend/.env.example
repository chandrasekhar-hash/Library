# ── Aks (अक्स) Server Environment Configuration ──────────────────────────────
# Application Port
PORT=5050

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origin for the Frontend Single Page Application
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/aks_db?schema=public

# Session Secret (random 64+ char string for HMAC signing)
SESSION_SECRET=your_long_cryptographically_secure_session_secret_change_in_production

# Storage Directories (Relative to server root or absolute path)
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=150

# Reverse Proxy Trust Configuration (default: 1 in production, false in development/test)
# Accepts: true | false | number of hops (e.g. 1) | subnet IP string
TRUST_PROXY=1

# ── Google OAuth 2.0 Configuration ──────────────────────────────────────────
# Required to enable "Continue with Google" sign-in on the login screen.
# Obtain these credentials from the Google Cloud Console (https://console.cloud.google.com/apis/credentials):
# 1. Create or select a Google Cloud Project.
# 2. Configure the OAuth Consent Screen (External or Internal user type, add "openid", "email", "profile" scopes).
# 3. Under "Credentials", click "Create Credentials" -> "OAuth Client ID".
# 4. Select Application Type: "Web application".
# 5. Add Authorized JavaScript Origins: http://localhost:5173
# 6. Add Authorized Redirect URIs: http://localhost:5050/api/auth/google/callback
# 7. Copy the generated Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# ── Internal Python OCR Engine Configuration ────────────────────────────────
# URL of the self-hosted Python OCR FastAPI Worker (bound strictly to loopback)
OCR_WORKER_URL=http://127.0.0.1:5060
# Internal shared secret Bearer token for Node.js-to-Python communication
OCR_WORKER_TOKEN=aks-internal-dev-token
# Total document job timeout in milliseconds (default: 300,000 ms / 5 minutes)
OCR_WORKER_TIMEOUT_MS=300000
# Global concurrent OCR job limit (default: 1)
OCR_MAX_CONCURRENT_JOBS=1


